model pesuser {
  id                     Int             @id @unique(map: "pesuser_id_unique") @default(autoincrement())
  name                   String          @db.VarChar(255)
  email                  String          @unique @db.VarChar(255)
  password               String          @db.VarChar(255)
  gsm                    String?         @db.VarChar(50)
  // Email deliverability, updated by the Resend webhook: delivered | bounced |
  // complained. "bounced" flags the address as undeliverable in the UI.
  email_status           String?         @db.VarChar(30)
  email_status_at        DateTime?
  // Read access the org admin grants a staff member to see their own
  // department's / faculty's stress results (toggled by the admin).
  view_department_stress Boolean         @default(false)
  view_faculty_stress    Boolean         @default(false)
  // Functional role — always a system PRESET so role-based UI stays predictable.
  role                   String?         @db.VarChar(50)
  // Human-facing role label to SHOW (e.g. the custom role name "Paginator").
  // Falls back to `role` when the employee holds a preset directly.
  display_role           String?         @db.VarChar(255)
  address                String?
  faculty_college        String?         @db.VarChar(255)
  dob                    DateTime?       @db.Date
  doa                    DateTime?       @db.Date
  poa                    String?         @db.VarChar(255)
  doc                    String?         @db.VarChar(255)
  post                   String?         @db.VarChar(255)
  dopp                   DateTime?       @db.Date
  level                  String?         @db.VarChar(50)
  image                  String?         @db.VarChar(255)
  org                    String?         @db.VarChar(255)
  dept                   String?         @db.VarChar(255)
  tier                   String?         @default("bronze") @db.VarChar(50)
  category               String?         @db.VarChar(100)
  plan                   String?         @db.VarChar(100)
  resettoken             String?         @db.VarChar(255)
  resettokenexpiry       DateTime?       @db.Timestamp(6)
  audit_count            Int?            @default(0)
  updated_at             DateTime?       @default(now()) @db.Timestamp(6)
  notifications          notifications[]
  subscriptions          subscriptions[]

  @@unique([name, dept, org], map: "unique_user_per_dept_org")
  @@index([resettoken], map: "idx_pesuser_resettoken")
  @@index([resettokenexpiry], map: "idx_pesuser_resettokenexpiry")
}

