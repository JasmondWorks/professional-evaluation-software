// ---------------------------------------------------------------------------
// Appraisal model (academic and non-academic)
//
// The scoring rules live in app/lib/appraisal/. These tables hold the per-org
// configuration and the per-period entries the engine runs over.
// ---------------------------------------------------------------------------

// An appraisal period, opened by Estab./Personnel. The client confirmed this is
// configurable rather than fixed to a year: yearly, bi-annual or quarterly.
// Every score belongs to exactly one period so figures can never mix across
// periods.
model appraisal_period {
  id          Int       @id @default(autoincrement())
  org         String    @db.VarChar(255)
  frequency   String    @db.VarChar(20)
  starts_on   DateTime  @db.Date
  ends_on     DateTime  @db.Date
  // 'open' while entries are accepted, 'closed' once Estab./Personnel has run
  // the final evaluation.
  status      String    @default("open") @db.VarChar(20)
  opened_by   String?   @db.VarChar(255)
  // Closing a period ends data entry. Releasing is a separate, deliberate act by
  // the organization admin, which is when staff finally see their grade.
  released_at DateTime? @db.Timestamp(6)
  released_by String?   @db.VarChar(255)
  created_at  DateTime? @default(now()) @db.Timestamp(6)

  targets    appraisal_target[]
  entries    appraisal_entry[]
  courses    appraisal_course[]
  indicators appraisal_indicator[]

  @@index([org, status])
}

// Annual targets, per org and per period so an institution can adjust them
// without rewriting history. Seeded from ACADEMIC_TARGETS in the instrument.
//
// This table exists so the two targets the source document never supplied — the
// student evaluation target, and the whole non-academic cadre scheme — can be
// filled in as configuration rather than blocking the model. A missing row means
// "not targeted", and the engine leaves that category out of the combined total
// instead of scoring it as zero.
model appraisal_target {
  id        Int     @id @default(autoincrement())
  org       String  @db.VarChar(255)
  period_id Int?
  // 'academic' | 'non_academic'
  model     String  @db.VarChar(20)
  // Academic positions key on position; administration keys on post held;
  // non-academic keys on cadre. Exactly one of these is set.
  position  String? @db.VarChar(60)
  post      String? @db.VarChar(60)
  cadre     String? @db.VarChar(60)
  // One of the five CategoryKey values, or null for the non-academic single
  // combined target.
  category  String? @db.VarChar(40)
  target    Decimal @db.Decimal(10, 2)

  period appraisal_period? @relation(fields: [period_id], references: [id], onDelete: Cascade)

  @@unique([org, period_id, model, position, post, cadre, category], map: "appraisal_target_unique")
  @@index([org, model])
}

// One staff member's appraisal within a period: the five category results and
// the reconciliation state. `flagged` is visible only to the organization admin.
model appraisal_entry {
  id           Int     @id @default(autoincrement())
  org          String  @db.VarChar(255)
  dept         String? @db.VarChar(255)
  period_id    Int
  pesuser_name String  @db.VarChar(255)
  model        String  @db.VarChar(20)
  position     String? @db.VarChar(60)
  post         String? @db.VarChar(60)
  cadre        String? @db.VarChar(60)

  total_observed Decimal? @db.Decimal(12, 3)
  total_target   Decimal? @db.Decimal(12, 3)
  rtp            Decimal? @db.Decimal(10, 3)
  grade          String?  @db.VarChar(20)
  // True when a scored category had no configured target, so the combined
  // figure covers only part of the appraisal.
  partial_target Boolean  @default(false)

  // Workflow: 'draft' | 'submitted' | 'hod_reviewed' | 'awaiting_staff' |
  // 'referred_to_auditor' | 'approved'
  status            String    @default("draft") @db.VarChar(30)
  flagged           Boolean   @default(false)
  submitted_at      DateTime? @db.Timestamp(6)
  approved_at       DateTime? @db.Timestamp(6)
  // The non-academic qualitative questionnaire, items (a) to (h).
  questionnaire     Json?
  // The departmental administrator checks Forms 8 and 9 against the paper
  // originals before the HOD reviews anything (full document, page 21).
  verified_at       DateTime? @db.Timestamp(6)
  verified_by       String?   @db.VarChar(255)
  verification_note String?
  // The Dean approves a department's submissions before Estab./Personnel run
  // the final evaluation. Deans do not score individual academics.
  dean_approved_at  DateTime? @db.Timestamp(6)
  dean_approved_by  String?   @db.VarChar(255)
  created_at        DateTime? @default(now()) @db.Timestamp(6)
  updated_at        DateTime? @default(now()) @db.Timestamp(6)

  period     appraisal_period           @relation(fields: [period_id], references: [id], onDelete: Cascade)
  categories appraisal_category_score[]
  evidence   appraisal_evidence[]

  @@unique([period_id, pesuser_name], map: "appraisal_entry_unique")
  @@index([org, status])
  @@index([org, flagged])
}

// One category result within an entry, holding both the appraisee's figures and
// the HOD's counter-score plus the justification the model requires.
//
// `worth` is stored because it is needed to reproduce a historic result, but it
// must never be sent to the browser: the client confirmed the worth table stays
// unknown to every user, the organization admin included.
model appraisal_category_score {
  id       Int    @id @default(autoincrement())
  entry_id Int
  category String @db.VarChar(40)

  // Line-item scores as entered, kept so a result can be audited back to source.
  line_items Json?
  quality    Decimal? @db.Decimal(6, 2)
  quantity   Decimal? @db.Decimal(12, 4)
  worth      Int?
  observed   Decimal? @db.Decimal(12, 3)
  target     Decimal? @db.Decimal(10, 2)

  // Reconciliation. hod_score is the HOD/Unit Max Score.
  appraisal_score   Decimal? @db.Decimal(6, 2)
  hod_score         Decimal? @db.Decimal(6, 2)
  hod_justification String?
  staff_accepted    Boolean?
  // 'accepted' | 'accepted_by_staff' | 'referred_to_auditor' |
  // 'awaiting_staff_response'
  reconciliation    String?  @db.VarChar(40)
  recorded_score    Decimal? @db.Decimal(6, 2)
  auditor_score     Decimal? @db.Decimal(6, 2)
  auditor_note      String?

  // Student evaluation only: how many completed copies were submitted. The
  // recorded quality is their mean, and the course cannot be scored below the
  // minimum.
  copies_submitted Int?
  // Kept so a saved form can be shown back as it was entered. Quantity alone
  // cannot be decomposed into these two.
  student_count    Int?
  basic_units      Decimal? @db.Decimal(6, 2)

  entry appraisal_entry @relation(fields: [entry_id], references: [id], onDelete: Cascade)

  @@unique([entry_id, category], map: "appraisal_category_unique")
}

// A piece of evidence feeding the quantity side: which quantification rule it
// falls under, and its measure (pages, semester hours, or certified works).
model appraisal_evidence {
  id           Int      @id @default(autoincrement())
  entry_id     Int
  category     String   @db.VarChar(40)
  rule_key     String   @db.VarChar(60)
  label        String?  @db.VarChar(255)
  measure      Decimal  @db.Decimal(12, 3)
  scripts      Int?
  // Uploaded proof, required for research entries.
  evidence_url String?  @db.VarChar(500)
  units        Decimal? @db.Decimal(12, 4)

  entry appraisal_entry @relation(fields: [entry_id], references: [id], onDelete: Cascade)

  @@index([entry_id, category])
}

// The course registry (Form 2). Course units feed the teaching quantity, so a
// course must exist before a lecturer can be appraised on it.
model appraisal_course {
  id         Int       @id @default(autoincrement())
  org        String    @db.VarChar(255)
  period_id  Int
  dept       String?   @db.VarChar(255)
  title      String    @db.VarChar(255)
  code       String    @db.VarChar(50)
  unit       Decimal   @db.Decimal(6, 2)
  created_at DateTime? @default(now()) @db.Timestamp(6)

  period appraisal_period @relation(fields: [period_id], references: [id], onDelete: Cascade)

  @@unique([org, period_id, code], map: "appraisal_course_unique")
  @@index([org, period_id])
}

// Form 4: which departmental indicators apply to a given staff member. This is
// what defines the work a person will actually be appraised on.
model appraisal_indicator {
  id           Int       @id @default(autoincrement())
  org          String    @db.VarChar(255)
  period_id    Int
  pesuser_name String    @db.VarChar(255)
  // Which achievement category the indicator belongs to.
  category     String    @db.VarChar(40)
  label        String    @db.VarChar(255)
  // Set when the indicator is a registered course.
  course_id    Int?
  created_at   DateTime? @default(now()) @db.Timestamp(6)

  period appraisal_period @relation(fields: [period_id], references: [id], onDelete: Cascade)

  @@index([org, period_id, pesuser_name])
}

// ---------------------------------------------------------------------------
// Performance model (client instruction, 22 Aug 2026)
// ---------------------------------------------------------------------------
//
// Four criteria collected per staff member, each normalised to 100, plus the
// overall as their mean — five results in all — then RTP-graded against a target
// of 55. The head counter-scores with a written reason; the staff member accepts
// or rejects; a rejection goes to the external auditor, whose figure is final.
//
// These tables replace the flat `userperformance` / `counter_userperformance`
// pair, which held one overwritten row per staff member with no period, no
// per-criterion result, no overall, no grade and nowhere to put the head's
// reason or the auditor's ruling.

model performance_period {
  id            Int       @id @default(autoincrement())
  org           String    @db.VarChar(255)
  frequency     String    @db.VarChar(20)
  starts_on     DateTime  @db.Date
  ends_on       DateTime  @db.Date
  // 'open' while entries are accepted, 'closed' once the org admin has run the
  // final evaluation, then released separately.
  status        String    @default("open") @db.VarChar(20)
  opened_by     String?   @db.VarChar(255)
  released_at   DateTime? @db.Timestamp(6)
  released_by   String?   @db.VarChar(255)
  // Per-period overrides of the defaults in the instrument, so an organization
  // can adjust without a code change.
  target        Decimal   @default(55.00) @db.Decimal(6, 2)
  rater_sample  Int       @default(5)
  rater_minimum Int       @default(3)
  created_at    DateTime? @default(now()) @db.Timestamp(6)

  entries     performance_entry[]
  hod_results hod_performance_result[]
  assignments hod_performance_rater[]

  @@index([org, status])
}

// One staff member's performance within a period: the fifth result, its RTP and
// grade, and the workflow state. `flagged` is visible only to the org admin.
model performance_entry {
  id           Int     @id @default(autoincrement())
  org          String  @db.VarChar(255)
  dept         String? @db.VarChar(255)
  period_id    Int
  pesuser_name String  @db.VarChar(255)

  // The fifth result: the mean of the four criteria, on a 0-100 scale.
  overall     Decimal? @db.Decimal(6, 2)
  target      Decimal? @db.Decimal(6, 2)
  rtp         Decimal? @db.Decimal(10, 3)
  grade       String?  @db.VarChar(20)
  // The document's own seven-class scheme (page 101), kept because the
  // motivation model's winning criteria are written in that vocabulary.
  class_rank  String?  @db.VarChar(20)
  descriptive String?  @db.VarChar(30)
  // True when fewer than four criteria were settled, so the overall covers only
  // part of the assessment.
  partial     Boolean  @default(false)

  // 'draft' | 'submitted' | 'awaiting_staff' | 'referred_to_auditor' |
  // 'evaluated'
  status       String    @default("draft") @db.VarChar(30)
  flagged      Boolean   @default(false)
  submitted_at DateTime? @db.Timestamp(6)
  evaluated_at DateTime? @db.Timestamp(6)
  created_at   DateTime? @default(now()) @db.Timestamp(6)
  updated_at   DateTime? @default(now()) @db.Timestamp(6)

  period   performance_period            @relation(fields: [period_id], references: [id], onDelete: Cascade)
  criteria performance_criterion_score[]

  @@unique([period_id, pesuser_name], map: "performance_entry_unique")
  @@index([org, status])
  @@index([org, flagged])
}

// One criterion's result within an entry, holding the staff member's own figure,
// the head's counter-score with its mandatory reason, and the auditor's ruling.
model performance_criterion_score {
  id        Int    @id @default(autoincrement())
  entry_id  Int
  // 'competence' | 'integrity' | 'compatibility' | 'use_of_resources'
  criterion String @db.VarChar(40)

  // Ratings as entered, one per work parameter, kept so a result can be audited
  // back to source.
  ratings     Json?
  // The criterion normalised to 100.
  staff_score Decimal? @db.Decimal(6, 2)

  hod_score         Decimal? @db.Decimal(6, 2)
  hod_justification String?
  staff_accepted    Boolean?
  // 'accepted' | 'accepted_by_staff' | 'referred_to_auditor' |
  // 'awaiting_staff_response'
  reconciliation    String?  @db.VarChar(40)
  // The figure that counts towards the overall. Null while a disagreement is
  // unresolved: held out of the results, not discarded.
  recorded_score    Decimal? @db.Decimal(6, 2)
  auditor_score     Decimal? @db.Decimal(6, 2)
  auditor_note      String?

  entry performance_entry @relation(fields: [entry_id], references: [id], onDelete: Cascade)

  @@unique([entry_id, criterion], map: "performance_criterion_unique")
}

// A staff member drawn at random to score their head. One row per (period, head,
// rater). The draw happens once, when the org admin closes data collection.
model hod_performance_rater {
  id         Int    @id @default(autoincrement())
  org        String @db.VarChar(255)
  period_id  Int
  dept       String @db.VarChar(255)
  hod_name   String @db.VarChar(255)
  // The selected staff member. Their identity is never shown to the head.
  rater_name String @db.VarChar(255)

  // Their two returns, each normalised to 100, plus the ratings behind them.
  management_ratings   Json?
  productivity_ratings Json?
  management           Decimal?  @db.Decimal(6, 2)
  productivity         Decimal?  @db.Decimal(6, 2)
  submitted_at         DateTime? @db.Timestamp(6)
  created_at           DateTime? @default(now()) @db.Timestamp(6)

  period performance_period @relation(fields: [period_id], references: [id], onDelete: Cascade)

  @@unique([period_id, hod_name, rater_name], map: "hod_performance_rater_unique")
  @@index([org, period_id, hod_name])
  @@index([rater_name])
}

// A head's own performance result for the period, aggregated from the returns of
// the staff drawn to score them.
model hod_performance_result {
  id        Int    @id @default(autoincrement())
  org       String @db.VarChar(255)
  period_id Int
  dept      String @db.VarChar(255)
  hod_name  String @db.VarChar(255)

  management    Decimal?  @db.Decimal(6, 2)
  productivity  Decimal?  @db.Decimal(6, 2)
  overall       Decimal?  @db.Decimal(6, 2)
  target        Decimal?  @db.Decimal(6, 2)
  rtp           Decimal?  @db.Decimal(10, 3)
  grade         String?   @db.VarChar(20)
  class_rank    String?   @db.VarChar(20)
  descriptive   String?   @db.VarChar(30)
  // How many of the selected staff returned a score, and whether that was too
  // few for the result to stand.
  raters        Int       @default(0)
  below_minimum Boolean   @default(false)
  evaluated_at  DateTime? @db.Timestamp(6)
  created_at    DateTime? @default(now()) @db.Timestamp(6)

  period performance_period @relation(fields: [period_id], references: [id], onDelete: Cascade)

  @@unique([period_id, hod_name], map: "hod_performance_result_unique")
  @@index([org, period_id])
}

// Which models a non-admin role may reach, per organization.
//
// The client's rule: only the organization admin runs the models, and the
// industrial/production engineer may enter data into the ones the admin has
// switched on for them. Absence of a row means "not enabled" — access is opt-in,
// so a model added later is closed until somebody opens it.
model model_access {
  id         Int      @id @default(autoincrement())
  org        String   @db.VarChar(255)
  role       String   @db.VarChar(60)
  // A key from MODEL_CATALOG in app/lib/models/catalog.ts.
  model_key  String   @db.VarChar(60)
  enabled    Boolean  @default(false)
  updated_by String?  @db.VarChar(255)
  updated_at DateTime @default(now()) @db.Timestamp(6)

  @@unique([org, role, model_key], map: "model_access_unique")
  @@index([org, role])
}
