model stress {
  id                            Int       @id @default(autoincrement())
  pesuser_name                  String    @db.VarChar(255)
  org                           String?   @db.VarChar(255)
  stress_theme                  Int?
  stress_feeling_frequency      Int?
  stress_category               Int?
  stress_theme_form             Int?
  stress_feeling_frequency_form Int?
  assessment_data               Json?
  dept                          String?   @db.VarChar(255)
  // Which cycle this Form 6/7 submission belongs to (one submission per cycle).
  cycle_id                      Int?
  // Two-tier approval. Tier 1: the department head (HOD) verifies & approves
  // their department's submissions (hod_approved). Tier 2: the faculty/division
  // head (Dean/Manager) then signs off the faculty — but only submissions that
  // are already hod_approved. `approved` is the final (faculty) approval; the
  // admin can only evaluate once every submission is `approved`.
  hod_approved                  Boolean   @default(false)
  hod_approved_by               String?   @db.VarChar(255)
  hod_approved_at               DateTime?
  approved                      Boolean   @default(false)
  approved_by                   String?   @db.VarChar(255)
  approved_at                   DateTime?
  // A head can send a submission back for re-entry with a reason. While
  // rejected, it counts as "not submitted" until the staff member re-submits.
  rejected                      Boolean   @default(false)
  rejection_reason              String?
  rejected_by                   String?   @db.VarChar(255)
  rejected_at                   DateTime?
}

model stress_analysis_results {
  id             Int       @id @default(autoincrement())
  org            String?   @db.VarChar(255)
  group_by       String?   @db.VarChar(50)
  ssto           Float?
  sstr           Float?
  sse            Float?
  f_statistic    Float?
  critical_value Float?
  conclusion     String?
  df_between     Int?
  df_within      Int?
  ms_between     Float?
  ms_within      Float?
  mean           Float?
  std_dev        Float?
  // Per-cycle linkage (the stress side of a cycle's outcome; the feeling side
  // lives in FeelingResult). Nullable — soft FK for legacy rows. See
  // docs/stress-sessions.md.
  cycle_id       Int?
  session_id     Int?
  created_at     DateTime? @default(now()) @db.Timestamp(6)

  @@index([cycle_id])
  @@index([session_id])
}

model stress_scores {
  id                       Int      @id @default(autoincrement())
  organizational           Decimal? @default(0) @db.Decimal
  student                  Decimal? @default(0) @db.Decimal
  administrative           Decimal? @default(0) @db.Decimal
  teacher                  Decimal? @default(0) @db.Decimal
  parents                  Decimal? @default(0) @db.Decimal
  occupational             Decimal? @default(0) @db.Decimal
