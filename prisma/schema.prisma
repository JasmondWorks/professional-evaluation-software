}

model roles {
  id       Int     @id @default(autoincrement())
  name     String  @db.VarChar(255)
  assigned Int?
  org      String? @db.VarChar(255)

  // Which system preset this custom role behaves as for role-based UI
  // (sidebar, conditional components). Employees created with this role get
  // `base_role` written into pesuser.role so those checks stay predictable.
  base_role String? @db.VarChar(50)

  // Role names are unique PER ORG, not globally — otherwise one org creating
  // "Paginator" blocks every other org from ever using that name.
  @@unique([name, org])
}

