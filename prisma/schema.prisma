  t1                 Float?
  t2                 Float?
  t3                 Float?
  t4                 Float?
  S0                 Float?
  createdAt          DateTime? @default(now()) @db.Timestamp(6)
  org                String?   @db.VarChar(255)
}

// A stress evaluation cycle for an org: the two collection windows, the current
// phase, and the per-category limits computed by "Run Setting" (the mean of
// Form 5 across all staff), which Form 6 then uses as its category maxes.
model StressCycle {
  id                 Int       @id @default(autoincrement())
  org                String    @db.VarChar(255)
  // settings_open | settings_closed | feeling_open | evaluated
  phase              String    @default("settings_open") @db.VarChar(30)
  mode               String    @default("once") @db.VarChar(20)
  settings_opens_at  DateTime?
  settings_closes_at DateTime?
  feeling_opens_at   DateTime?
  feeling_closes_at  DateTime?
  // Snapshot of the effective category limits for this cycle. Even when the
  // cycle reuses/loads limits (limits_source != 'recomputed') this holds the
  // resolved snapshot so a cycle is self-describing after a session reset.
  category_limits    Json?
  // Set when the evaluation's 5% rule fires — the next cycle must re-collect
  // Form 5 (settings) rather than reuse the stored limits.
  needs_reset        Boolean   @default(false)

  // --- WellbeingSession linkage (see docs/stress-sessions.md) ---
  // The session (a run of iterations sharing one F1 baseline) this cycle is in.
  session_id              Int?
  session                 WellbeingSession? @relation(fields: [session_id], references: [id])
  // Iteration `i` within the session. First real cycle = 1.
  iteration               Int?
  // How this cycle got its limits: recomputed | inherited | loaded_from_history
  limits_source           String?           @db.VarChar(30)
  // Soft reference (no FK, to avoid a self-relation) to the cycle whose limits
  // were reused/loaded. `category_limits` above is the resolved snapshot.
  inherited_from_cycle_id Int?

  feelingResults FeelingResult[]

  created_by String?  @db.VarChar(255)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@index([org])
  @@index([session_id])
}

// A WellbeingSession groups an org's stress + feeling cycles (iterations) that
// share one F1 baseline. A reset (feeling mean outside F1 ± 5%) ends the session
// and a new one begins. Nothing is deleted — old sessions/cycles stay for
// history recall. See docs/stress-sessions.md.
model WellbeingSession {
  id                 Int       @id @default(autoincrement())
  org                String    @db.VarChar(255)
  // active | reset | closed
  status             String    @default("active") @db.VarChar(20)
  // Iteration of the latest cycle (0 = just started / just reset).
  current_iteration  Int       @default(0)
  // The ±5% baseline: the org-level feeling value from iteration 1 and the
  // Form 5 limits that produced it.
  f1_feeling_value   Float?
  f1_category_limits Json?
  started_at         DateTime  @default(now()) @db.Timestamptz(6)
  ended_at           DateTime?
  // e.g. "5% rule: feeling mean outside F1 band"
  ended_reason       String?   @db.VarChar(255)
  created_by         String?   @db.VarChar(255)

  cycles         StressCycle[]
  feelingResults FeelingResult[]

  @@index([org])
}

// The feeling side of a cycle's outcome. Kept separate from the stress side
// (stress_analysis_results / ANOVA) — the two are never mixed in one row.
model FeelingResult {
  id              Int               @id @default(autoincrement())
  cycle_id        Int
  cycle           StressCycle       @relation(fields: [cycle_id], references: [id])
  session_id      Int?
  session         WellbeingSession? @relation(fields: [session_id], references: [id])
  // Mean feeling across all staff who took part in this cycle.
  feeling_mean    Float?
  // Result of the ±5% test against the session's F1.
  within_f1_band  Boolean?
  // True when this result ended the session (out of band → reset).
  triggered_reset Boolean           @default(false)
  created_at      DateTime          @default(now()) @db.Timestamptz(6)

  @@index([cycle_id])
  @@index([session_id])
}

